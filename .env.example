# Copy to .env and fill in whatever you have. EVERY key is optional:
# with none set, each stage uses an offline / no-key fallback.

# ---------- LLM (topic generation + script rewriting) -------------------
# Tried in this order; the first that answers wins.
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenRouter free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Fully local + open-source: install Ollama, `ollama pull llama3.2`, then set:
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Trend signals + video search --------------------------------
# YouTube Data API v3 (free 10,000 units/day): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
YOUTUBE_REGION=US
# Only curate Creative-Commons licensed videos (requires YOUTUBE_API_KEY)
CREATIVE_COMMONS_ONLY=true

# ---------- Speech-to-text ------------------------------------------------
# Groq Whisper is used when GROQ_API_KEY is set; otherwise local faster-whisper.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# tiny | base | small | medium | large-v3  (downloaded on first use)
WHISPER_MODEL=base

# ---------- Text-to-speech ------------------------------------------------
# auto | edge | kokoro | gtts | espeak | silent
TTS_PROVIDER=auto
EDGE_TTS_VOICE=en-US-AriaNeural

# ---------- Image generation ------------------------------------------------
# Pollinations (free key): https://enter.pollinations.ai
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=flux
# Hugging Face Inference (free monthly credits): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ---------- Misc ------------------------------------------------------------
CURATOR_DATA_DIR=data
MAX_CLIP_SECONDS=90
# FONT_PATH=/path/to/font.ttf
